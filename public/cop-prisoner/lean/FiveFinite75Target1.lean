theorem guaranteed {G : Graph (Fin 75)}
    (low : RobustTwoMove.Subgraph lower G) (high : RobustTwoMove.Subgraph G upper)
    (s : Fin 75) : Guaranteed G s 1 := by
  intro c initial
  by_cases terminal : s=1
  · subst s; exact ⟨0,Winning.delivered⟩
