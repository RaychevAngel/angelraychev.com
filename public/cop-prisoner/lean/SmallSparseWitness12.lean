def rowMasks : Array Nat := #[
  0,4,3,20,40,80,35
]
def edge (s t : Fin 7) : Prop := (rowMasks[s.val]!).testBit t.val = true
instance (s t : Fin 7) : Decidable (edge s t) := inferInstanceAs (Decidable (_ = _))
instance (s t : Fin 7) : Decidable (Legal edge s t) :=
  inferInstanceAs (Decidable (s = t ∨ edge s t))
