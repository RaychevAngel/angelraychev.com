def data : Data 7 where
  signed t r c := signedRanks t.val r.val c.val
  move t r c := ⟨moves t.val r.val c.val % 7, Nat.mod_lt _ (by decide)⟩

theorem checked : Checked edge data := by
  constructor <;> decide +kernel
def classification := SignedRankCertificate.classification checked
theorem loopless : Loopless edge := by unfold Loopless; decide +kernel
theorem arrows : arcCount edge = 12 := by rw [arcCount_eq]; decide +kernel
theorem exact_score : score edge = 9 := by
  rw [ExactScoreCertificates.exact_score classification]
  decide +kernel
#print axioms checked
#print axioms exact_score
