    data.region x c ∧ data.rank x c≤originalBound := by
  intro x c entry pc safe
  apply GroupedArena.bounded rows x c originalBound
  rw [bounded_agrees]
  exact has_subset (entry_subset x entry) (required_coverage x c entry.1 pc safe)
noncomputable def certificate : OddEndpointCertificatesSpec.Delivery residue patchAnchor 1 where
  data := data
  checked := checked
  starts := by
    intro x c entry pc safe
    obtain ⟨inside,bound⟩ := initial_states x c entry pc safe
    exact ⟨inside,Nat.le_trans bound (by decide : originalBound≤deliveryBound residue)⟩
#print axioms certificate
end Delivery.OddEndpointObjective070Delivery1
