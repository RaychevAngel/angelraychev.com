def decode (a : K) (c : C) : V := decodeBits a.val c.val
def localCop (r : R) : C := ⟨r.val+15,by have:=r.isLt;omega⟩
def outside : C := 65
def embed (a : K) (r : R) : V := embedBits a.val r.val
def project (a : K) (c : V) : C := projectBits a.val c.val
def typ (s : V) : Fin 5 := ⟨s.val%5,Nat.mod_lt _ (by decide)⟩
def transferCenter (s : V) : K := ⟨(s.val/5+18-1)%18,Nat.mod_lt _ (by decide)⟩
def deliveryCenter (t : V) : K := ⟨t.val/5,by have:=t.isLt;omega⟩
def measure (t s : V) : Nat := (s.val/5+18-(t.val/5+2)%18)%18
theorem messenger_rows : ∀ a r, (moveRows r.val).all (fun z => decide (Legal lower (embed a r) (embed a z)))=true := by
  decide +kernel
theorem pursuer_rows : ∀ a c, (c::upperBits c.val).all (fun d => decide (arena.pursuer (project a c) (project a d)))=true := by
  decide +kernel
theorem project_embed : ∀ a r, project a (embed a r)=localCop r := by decide +kernel
theorem decode_embed : ∀ a r, decode a (localCop r)=embed a r := by decide +kernel
theorem retraction : ∀ a c, project a c≠outside → decode a (project a c)=c := by decide +kernel
theorem collision_iff : ∀ a r c, arena.collision r (project a c) ↔ embed a r=c := by
  intro a
  apply FiveTypeRetraction.collision_iff arena (embed a) (project a) (decode a) localCop outside
  · intro r c;change c.val=r.val+15 ↔ c=localCop r
    exact ⟨fun h => Fin.ext h,fun h => congrArg Fin.val h⟩
  · intro r;intro same
    have values := congrArg Fin.val same
    change r.val+15=65 at values
    have:=r.isLt;omega
  · exact project_embed a
  · exact decode_embed a
  · exact retraction a
theorem transfer_start : ∀ s, embed (transferCenter s) (transferStart (typ s))=s := by
  decide +kernel
theorem delivery_start : ∀ t s, measure t s=0 → embed (deliveryCenter t) (deliveryStart (typ s))=s := by
  decide +kernel
theorem centered : ∀ a r, transferGoal r → (embed a r).val/5=a.val := by
  decide +kernel
theorem progress_columns : ∀ a b : K, 0<(b.val+18-(a.val+2)%18)%18 →
    ((b.val+18-1)%18+18-(a.val+2)%18)%18 < (b.val+18-(a.val+2)%18)%18 := by
  decide +kernel
theorem recipient : ∀ t r, deliveryGoal (typ t) r → embed (deliveryCenter t) r=t := by
  decide +kernel
def charts : Charts (k:=18) lower upper arena where
  embed := embed
  project := project
  messenger := by
    intro a r z move
    exact of_decide_eq_true ((List.all_eq_true.mp (messenger_rows a r)) z move)
  pursuer := by
    intro a c d reply
    have member : d∈c::upperBits c.val := by
      rcases reply with same|edge
      · exact List.mem_cons.mpr (Or.inl same.symm)
      · exact List.mem_cons.mpr (Or.inr edge)
    exact of_decide_eq_true ((List.all_eq_true.mp (pursuer_rows a c)) d member)
  collision := collision_iff
  typ := typ
  transferCenter := transferCenter
  deliveryCenter := deliveryCenter
  measure := measure
  transfer_start := transfer_start
  delivery_start := delivery_start
  progress := by
    intro t s r positive goal
    unfold measure
    rw [centered (transferCenter s) r goal]
    exact progress_columns (deliveryCenter t) (deliveryCenter s) positive
  recipient := recipient

theorem subset : Subgraph lower upper := by unfold Subgraph; decide +kernel
theorem noLoops : Loopless upper := by unfold Loopless; decide +kernel
theorem base_count : arcCount lower=180 := by rw [arcCount_eq]; decide +kernel
theorem upper_count : arcCount upper=270 := by rw [arcCount_eq]; decide +kernel
theorem delivers : GuaranteedPrefix.Delivers lower upper :=
  FiveTypeWindow.delivers FiveFullCertificates.certificates charts
theorem winning (G : Graph V) (lo : Subgraph lower G) (hi : Subgraph G upper)
    (t s c : V) (safe : s≠c) : Winning G t (measure t s*8+24) s c :=
  FiveTypeWindow.winning FiveFullCertificates.certificates charts lo hi t s c safe
theorem maximum {m : Nat} (lo : 180≤m) (hi : m≤270) :
    IsMaximum 90 m (90*(90-1)-m) :=
  GuaranteedPrefix.maximum lower upper subset noLoops delivers
    (by simpa only [base_count] using lo) (by simpa only [upper_count] using hi)
#print axioms collision_iff
#print axioms winning
#print axioms maximum
end Delivery.FiveFullRing18
