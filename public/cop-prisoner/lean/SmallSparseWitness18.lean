def edge (s t : Fin 9) : Prop := (rowMasks[s.val]!).testBit t.val = true
instance (s t : Fin 9) : Decidable (edge s t) := inferInstanceAs (Decidable (_ = _))
instance (s t : Fin 9) : Decidable (Legal edge s t) :=
  inferInstanceAs (Decidable (s = t ∨ edge s t))
