theorem entries : ∀ s t, accepted s t=true → ∀ c, c≠s → 0<data.code t s c := by decide +kernel
theorem loopless : Loopless edge := by unfold Loopless; decide +kernel
theorem arrows : arcCount edge=210 := by rw [arcCount_eq]; decide +kernel
theorem count : acceptedCount edge accepted=28 := by decide +kernel
theorem maximum : IsMaximum 16 210 28 := by
  apply WinningScoreRows.maximum edge data replies accepted coverage rows_checked entries loopless arrows count
  intro F loops budget
  exact DenseStaircase.bound_at_offset F loops (by decide) (by decide : 1≤2) (by decide)
    (by simpa using budget)
theorem score_exact : score edge=28 := by
  have lower := WinningScoreRows.lower_bound edge data replies accepted coverage rows_checked entries
  have bound := maximum.1 edge loopless arrows
  rw [count] at lower
  omega
def attainer : DenseClassification.Attainer 16 210 28 :=
  ⟨edge,loopless,arrows,score_exact⟩
