  signed t r c := signedRanks t.val r.val c.val
  move t r c := ⟨(moves t.val r.val c.val) % 11, Nat.mod_lt _ (by decide)⟩

theorem checked : Checked edge data := by
  constructor <;> decide +kernel

def classification := SignedRankCertificate.classification checked

theorem loopless : Loopless edge := by
  unfold Loopless
  decide +kernel

