theorem replies_checked : ∀ c, (replyRows c.val).all (fun d => (replyMasks c).testBit d.val)=true := by decide +kernel
theorem reply_coverage : ∀ c d, arena.pursuer c d → Has (replyMasks c) d := by
  intro c d mem; exact (List.all_eq_true.mp (replies_checked c)) d mem
theorem collision_coverage : ∀ r c, arena.collision r c → Has (collisionMasks r) c := by
  unfold Has; decide +kernel
theorem required_coverage : ∀ r c, ¬arena.collision r c → Has (requiredMasks r) c := by
  unfold Has; decide +kernel
