import DeliveryGame

/-! Explicit 12-vertex graph and finite rank certificate.
Every rank decrease, chosen legal action, and possible pursuer reply is checked
by the Lean kernel. No external solver correctness assertion is assumed. -/
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Delivery.TwelveVertex
abbrev Vertex := Fin 12
def edge (r c : Vertex) : Prop :=
  (r.val = 0 ∧ c.val = 10) ∨
  (r.val = 0 ∧ c.val = 4) ∨
  (r.val = 1 ∧ c.val = 4) ∨
  (r.val = 1 ∧ c.val = 5) ∨
  (r.val = 2 ∧ c.val = 11) ∨
  (r.val = 2 ∧ c.val = 0) ∨
  (r.val = 3 ∧ c.val = 9) ∨
  (r.val = 3 ∧ c.val = 1) ∨
  (r.val = 4 ∧ c.val = 1) ∨
  (r.val = 4 ∧ c.val = 7) ∨
  (r.val = 5 ∧ c.val = 8) ∨
  (r.val = 5 ∧ c.val = 11) ∨
  (r.val = 6 ∧ c.val = 7) ∨
  (r.val = 6 ∧ c.val = 2) ∨
  (r.val = 7 ∧ c.val = 6) ∨
  (r.val = 7 ∧ c.val = 10) ∨
  (r.val = 8 ∧ c.val = 0) ∨
  (r.val = 8 ∧ c.val = 6) ∨
  (r.val = 9 ∧ c.val = 3) ∨
  (r.val = 9 ∧ c.val = 8) ∨
  (r.val = 10 ∧ c.val = 5) ∨
  (r.val = 10 ∧ c.val = 3) ∨
  (r.val = 11 ∧ c.val = 2) ∨
  (r.val = 11 ∧ c.val = 9)
instance (r c : Vertex) : Decidable (edge r c) := inferInstanceAs (Decidable (_ ∨ _))
instance (r c : Vertex) : Decidable (Legal edge r c) :=
  inferInstanceAs (Decidable (r = c ∨ edge r c))

