noncomputable def rows (r : Fin 70) : List (Group 70 70) := groupRows r.val
theorem groups_checked : GroupedArena.Checked true (arena lower upper) (fun r => r=0)
    replyMasks collisionMasks rows := by
  unfold GroupedArena.Checked; decide +kernel
theorem entry_subset : ∀ s : Fin 70, s≠0 → ¬lower s 0 →
    initialMask s &&& activeMask (rows s)=initialMask s := by decide +kernel
theorem winning {G : Graph (Fin 70)}
    (low : RobustTwoMove.Subgraph lower G) (high : RobustTwoMove.Subgraph G upper)
    (r c : Fin 70) (inside : Active (rows r) c) :
    Winning G 0 ((GroupedArena.data rows).rank r c) r c := by
  exact LocalArena.delivery_projection (simulation low high)
    (GroupedArena.delivery_checked (arena lower upper) (fun r => r=0)
      replyMasks collisionMasks rows reply_coverage (collision_covered lower upper) groups_checked)
    (fun _ same => same) r c inside
theorem guaranteed {G : Graph (Fin 70)}
    (low : RobustTwoMove.Subgraph lower G) (high : RobustTwoMove.Subgraph G upper)
    (s : Fin 70) : Guaranteed G s 0 := by
  intro c initial
  by_cases terminal : s=0
  · subst s; exact ⟨0,Winning.delivered⟩
  by_cases direct : lower s 0
  · exact ⟨1,Winning.finish (Ne.symm initial) (Or.inr (low s 0 direct))⟩
  have active := (has_activeMask (rows s) c).mp
    (has_subset (entry_subset s terminal direct) ((has_initialMask s c).mpr initial))
  exact ⟨_,winning low high s c active⟩
#print axioms winning
#print axioms guaranteed
