theorem guaranteed {G : Graph (Fin 75)}
    (low : RobustTwoMove.Subgraph lower G) (high : RobustTwoMove.Subgraph G upper)
    (s : Fin 75) : Guaranteed G s 4 := by
  intro c initial
  by_cases terminal : s=4
  · subst s; exact ⟨0,Winning.delivered⟩
  by_cases direct : lower s 4
  · exact ⟨1,Winning.finish (Ne.symm initial) (Or.inr (low s 4 direct))⟩
