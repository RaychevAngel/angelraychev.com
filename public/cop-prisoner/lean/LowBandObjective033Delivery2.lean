  decide +kernel
theorem checked : DeliveryChecked (arena pattern) (deliveryGoal pattern 2) data := by
  rw [←arena_eq]
  exact delivery_checked frozenArena (deliveryGoal pattern 2) data frozenReplies (fun _ _ h => h) rows_checked
theorem initial_states : ∀ r c, presentR pattern r → (rcol r=5 ∨ rcol r=6) →
    presentC pattern c → ¬(arena pattern).collision r c →
    data.region r c ∧ data.rank r c≤(if rcol r=5 then 39 else 38) := by
  decide +kernel
