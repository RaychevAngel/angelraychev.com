import FourCubeNormalForm
import FiniteIdealCertificates

namespace Princess.FourCubeCompression
open Princess.ProductCompression Princess.CaptureRecurrence

def downMask (v : Room) : Nat := ( >>> (64*v.val)) &&& 18446744073709551615
def route (u v : Room) : Room := ⟨( >>> (6*(64*v.val+u.val))) %64,by omega⟩
def routePair (u v : Room) : Fin 3 := ⟨(( >>> (2*(64*v.val+u.val))) &&& 3)%3,by omega⟩
def routeDir (u v : Room) : Bool := ( >>> (64*v.val+u.val)).testBit 0

def downStep (pair : Fin 3) (dir : Bool) (u v : Room) : Prop :=
  (toPair pair u).2 = (toPair pair v).2 ∧
  SquareCompressionFour.key dir (toPair pair u).1 = SquareCompressionFour.key dir (toPair pair v).1 ∧
  SquareCompressionFour.rank dir (toPair pair u).1 ≤ SquareCompressionFour.rank dir (toPair pair v).1
instance (pair : Fin 3) (dir : Bool) (u v : Room) : Decidable (downStep pair dir u v) :=
  inferInstanceAs (Decidable (_ ∧ _ ∧ _))

def color (v : Room) : Nat := ((x v).val+(y v).val+(z v).val)%2

theorem down_self : ∀ v : Room, (downMask v).testBit v.val=true := by decide

theorem down_color : ∀ u v : Room, (downMask v).testBit u.val=true → color u=color v := by decide

set_option maxRecDepth 100000 in
set_option maxHeartbeats 5000000 in
theorem route_valid : ∀ u v : Room, (downMask v).testBit u.val=true → u≠v →
    weight (route u v) < weight v ∧ (downMask (route u v)).testBit u.val=true ∧
      downStep (routePair u v) (routeDir u v) (route u v) v := by decide +kernel

end Princess.FourCubeCompression
