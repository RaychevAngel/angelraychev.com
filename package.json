{
  "name": "angelraychev",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:math-dependencies && astro build && node scripts/prepare-math-output.mjs && npm run check:math",
    "check:math-dependencies": "node scripts/math-audit.mjs --dependencies-only",
    "check:math": "node scripts/math-audit.mjs",
    "test:math": "node --test scripts/math-audit.test.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "astro": "^7.3.1",
    "katex": "0.18.7",
    "parse5": "7.3.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}
