---
const { current, compact = false } = Astro.props;
const links = [
  ["notebook", "/sleep-notebook/", "Sleep performance"],
  ["targets", "/sleep/targets/", "Targets"],
  ["record", "/sleep/record/", "Sleep record"],
  ["charts", "/sleep/charts/", "Sleep curves"],
  ["measurements", "/sleep/measurements/", "Measurements"],
  ["research", "/sleep/research/", "Investigations"],
];
---
<nav class="sleep-nav" aria-label="Sleep pages">
  {compact ? <details class="reference-menu">
    <summary>Background and references</summary>
    <ul>{links.filter(([id]) => id !== current).map(([, href, title]) => <li><a href={href}>{title}</a></li>)}</ul>
  </details> : links.map(([id, href, title], i) => <>
    {i > 0 && " · "}
    {current === id ? <span aria-current="page">{title}</span> : <a href={href}>{title}</a>}
  </>)}
</nav>
<style>
  .sleep-nav { font-size: 13px; line-height: 1.9; margin: 0 0 32px; }
  .sleep-nav a, .sleep-nav span { white-space: nowrap; }
  .reference-menu summary { cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .reference-menu summary:focus-visible { outline: 1px solid var(--fg); outline-offset: 3px; }
  .reference-menu ul { margin: 12px 0 0; }
  :global(article h2[id]), :global(article h3[id]) { scroll-margin-top: 24px; }
</style>
