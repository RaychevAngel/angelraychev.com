---
const { entry } = Astro.props;
const s = entry.oura.sleep;
const formatDuration = (seconds: number) => `${Math.floor(seconds / 3600)}h ${String(Math.floor((seconds % 3600) / 60)).padStart(2, "0")}m`;
const segments = [
  { name: "Deep", seconds: s.deep_sleep_duration, kind: "deep" },
  { name: "REM", seconds: s.rem_sleep_duration, kind: "rem" },
  { name: "Light", seconds: s.light_sleep_duration, kind: "light" },
  { name: "Awake", seconds: s.awake_time, kind: "awake" },
];
const maxSeconds = Math.max(...segments.map((segment) => segment.seconds));
---
<figure>
  <div class="duration-chart" aria-label={`Oura aggregate durations for sleep ending ${entry.wake_date}`}>
    {segments.map((segment) => <div class="duration-row">
      <span>{segment.name}</span>
      <span class="bar-track" aria-hidden="true"><span class={`bar ${segment.kind}`} style={`width: ${segment.seconds / maxSeconds * 100}%`}></span></span>
      <span class="duration-value">{formatDuration(segment.seconds)}</span>
    </div>)}
  </div>
  <figcaption>One episode, four estimated totals. Bar length represents duration; positions do not represent the order of sleep stages. Oura's elapsed episode was {formatDuration(s.time_in_bed)}.</figcaption>
</figure>
<style>
  .duration-chart { margin: 24px 0; }
  .duration-row { display: grid; grid-template-columns: 4em minmax(0, 1fr) 6em; align-items: center; gap: 12px; margin: 14px 0; }
  .bar-track { display: block; min-width: 0; }
  .bar { display: block; height: 22px; border: 1px solid var(--fg); box-sizing: border-box; }
  .deep { background: #000; }
  .rem { background: repeating-linear-gradient(135deg, #fff 0px, #fff 4px, #000 4px, #000 5px); }
  .light { background: #767676; }
  .awake { background: #fff; }
  .duration-value { text-align: right; white-space: nowrap; }
  @media (max-width: 460px) { .duration-row { grid-template-columns: 3.5em minmax(0, 1fr) 5.5em; gap: 8px; } }
</style>
