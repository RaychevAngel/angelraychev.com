---
import witness from '../../public/cop-prisoner/explorer-graphs.json';
---
<section class="delivery-explorer" aria-label="Delivery game explorer" data-graphs={JSON.stringify(witness)}>
  <h2>Try a guaranteed delivery</h2>
  <p>Choose the starting positions. Each step shows an optimal messenger move followed by a pursuer response that delays delivery as long as possible. A guarantee covers every legal pursuer response.</p>
  <div class="controls">
    <label>Network <select data-network><option value="0">Two-branch diamond</option><option value="1">Diamond with an extra arc</option><option value="2">Optimal 12-station network</option></select></label>
    <label>Source <select data-source aria-label="Source"></select></label>
    <label>Recipient <select data-target aria-label="Recipient"></select></label>
    <label>Pursuer <select data-cop aria-label="Initial pursuer"></select></label>
  </div>
  <svg viewBox="0 0 600 420" role="img" aria-label="Directed network with messenger, recipient and pursuer positions" data-board></svg>
  <p class="legend">Blue fill: messenger · red outline: pursuer · double circle: recipient. Arrows show permitted moves; waiting is also allowed.</p>
  <p data-summary></p>
  <p data-status role="status" aria-live="polite"></p>
  <div class="buttons"><button data-step>Play one round</button><button data-reset>Reset positions</button></div>
  <ol data-history aria-label="Move history"></ol>
</section>
<script>
import {solveDelivery} from '../lib/delivery-game';
const el=document.querySelector<HTMLElement>('.delivery-explorer')!;
const graphs=JSON.parse(el.dataset.graphs!);
const pick=(s:string)=>el.querySelector<HTMLSelectElement>(s)!;
const network=pick('[data-network]'),source=pick('[data-source]'),target=pick('[data-target]'),cop=pick('[data-cop]');
const board=el.querySelector<SVGSVGElement>('[data-board]')!, status=el.querySelector<HTMLElement>('[data-status]')!;
const step=el.querySelector<HTMLButtonElement>('[data-step]')!,history=el.querySelector<HTMLOListElement>('[data-history]')!;
let g=graphs[0],r=0,c=1,t=3,round=0,game=solveDelivery(g.n,g.arcs,t);
function draw() {
  const xy=Array.from({length:g.n},(_,i)=>g.n===4?[[70,210],[300,65],[300,355],[530,210]][i]:[300+175*Math.cos(2*Math.PI*i/g.n-Math.PI/2),210+175*Math.sin(2*Math.PI*i/g.n-Math.PI/2)]);
  let svg='<defs><marker id="delivery-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#888"/></marker></defs>';
  for(const[u,v] of g.arcs){const[a,b]=xy[u],[x,y]=xy[v],d=Math.hypot(x-a,y-b),dx=(x-a)/d,dy=(y-b)/d;
    svg+=`<path d="M${a+23*dx},${b+23*dy} Q${(a+x)/2-12*dy},${(b+y)/2+12*dx} ${x-25*dx},${y-25*dy}" fill="none" stroke="#999" stroke-width="1.4" marker-end="url(#delivery-arrow)"/>`;}
  xy.forEach(([x,y],i)=>{svg+=`<g><circle cx="${x}" cy="${y}" r="21" fill="${i===r?'#d9ebfa':'#fff'}" stroke="${i===c?'#b33939':'#333'}" stroke-width="${i===c?3:1.5}"/>${i===t?`<circle cx="${x}" cy="${y}" r="17" fill="none" stroke="#333"/>`:''}<text x="${x}" y="${y+5}" text-anchor="middle" font-size="15" fill="#222">${g.labels[i]}</text></g>`;});
  board.innerHTML=svg;
}
function report() {
  draw(); const d=game.rank[r][c];
  status.textContent=r===t?`Delivered in ${round} messenger move${round===1?'':'s'}.`:r===c?'Intercepted.':d===Infinity?'This starting state has no guaranteed delivery. A winning strategy cannot be shown.':`Delivery is guaranteed within ${d} more messenger move${d===1?'':'s'}, against every response.`;
  step.disabled=r===t||r===c||d===Infinity;
}
function reset(){r=+source.value;t=+target.value;c=+cop.value;round=0;history.innerHTML='';game=solveDelivery(g.n,g.arcs,t);
  if(r===c){c=(r+1)%g.n;cop.value=String(c);}
  for(const o of cop.options)o.disabled=+o.value===r;
  const universal=game.rank[r].every((v,i)=>i===r||v<Infinity);
  el.querySelector('[data-summary]')!.textContent=`${g.n} stations, ${g.arcs.length} arcs, ${g.I} guaranteed indirect pair${g.I===1?'':'s'}. For this source and recipient, ${universal?'delivery works from every allowed pursuer start':'some pursuer start prevents a guarantee'}.`;
  report();}
function load(){g=graphs[+network.value]; for(const s of[source,target,cop]){s.innerHTML='';g.labels.forEach((name:string,i:number)=>s.add(new Option(name,String(i))));}
  source.value='0';target.value=String(g.n===4?3:11);cop.value='1';reset();}
network.addEventListener('change',load);for(const s of[source,target,cop])s.addEventListener('change',reset);
el.querySelector('[data-reset]')!.addEventListener('click',reset);
step.addEventListener('click',()=>{const from=r,oldc=c;r=game.messenger(r,c);round++;let msg=`Messenger: ${g.labels[from]} → ${g.labels[r]}.`;
  if(r!==t){c=game.pursuer(r,c);msg+=` Pursuer: ${g.labels[oldc]} → ${g.labels[c]}.`;}
  const li=document.createElement('li');li.textContent=msg;history.append(li);report();});load();
</script>
<style>
 .delivery-explorer{border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);padding:28px 0;margin:36px 0}.controls{display:flex;flex-wrap:wrap;gap:16px}label{display:flex;flex-direction:column;gap:5px;font-size:13px}select,button{font:inherit;padding:7px 10px;border:1px solid #aaa;border-radius:3px;background:#fff;color:#222}button{cursor:pointer}button:disabled{opacity:.45;cursor:default}.buttons{display:flex;gap:12px;margin-bottom:18px}.legend{font-size:12px;color:var(--dim)}svg{width:100%;margin:18px 0}h2{margin-top:0}ol:empty{display:none}
</style>
