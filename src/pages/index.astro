---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

// Planned pieces. Titles are working titles, not commitments.
const ideas = [
  "AI",
  "Athleticism",
  "Brain optimization",
  "Ending war",
  "Getting bad stuff out of your system",
  "God project",
  "Healthy",
  "Internet and the digital nomad independence",
  "Mindset",
  "Recovery",
  "The deal with food",
  "The legal system, governments, institutions",
  "What is a business",
  "Who controls the world",
];

const posts = (await getCollection("posts")).filter((p) => !p.data.draft);

const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });

const entries = [
  ...posts.map((p) => ({ title: p.data.title, href: `/${p.id}`, when: fmt(p.data.updated) })),
  ...ideas.map((title) => ({ title, href: null, when: "idea" })),
].sort((a, b) => a.title.localeCompare(b.title, "en"));
---
<Base home={true}>
  <ul class="idx">
    {entries.map((e) => (
      <li>
        {e.href ? <a href={e.href}>{e.title}</a> : <span class="idea">{e.title}</span>}
        <span class="when">{e.when}</span>
      </li>
    ))}
  </ul>
</Base>
