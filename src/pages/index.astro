---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { reports } from "../data/reports";

const posts = (await getCollection("posts")).filter((p) => !p.data.draft);
const items = [
  ...reports.map((r) => ({ href: `/reports/${r.slug}/`, title: r.title, description: r.description, date: new Date(r.date) })),
  ...posts.map((p) => ({ href: `/writing/${p.id}`, title: p.data.title, description: p.data.description ?? "", date: p.data.date })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const fmt = (d: Date) => d.toLocaleDateString("en-GB", { month: "short", year: "numeric" });
---
<Base description="Writing on physical capability, longevity, and the gap between what gets claimed and what survives checking.">
  <h1 class="vh">Angel Raychev</h1>
  <p class="lede">
    I write about physical capability, longevity, and the gap between what gets
    claimed and what survives checking.
  </p>

  <ul class="index">
    {items.map((it) => (
      <li>
        <a href={it.href}>
          <span class="head">
            <span class="t">{it.title}</span>
            <span class="when">{fmt(it.date)}</span>
          </span>
          <p class="d">{it.description}</p>
        </a>
      </li>
    ))}
  </ul>
</Base>
