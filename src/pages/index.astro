---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { publicationForPath } from "../lib/publications.mjs";

const introduction = "I'm an ML research engineer at SynthLabs. I build distributed training and evaluation systems, work on LLM post-training, and develop specialized agents.";

// Unwritten topics: keep this backlog in source, but do not render it on the site.
const ideas = [
  "AI",
  "Athleticism",
  "Brain optimization",
  "Ending war",
  "Getting bad stuff out of your system",
  "God project",
  "Healthy",
  "Internet and the digital nomad independence",
  "Mindset",
  "Recovery",
  "The legal system, governments, institutions",
  "What is a business",
  "Who controls the world",
];

const posts = (await getCollection("posts")).filter((p) => !p.data.draft);

const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).replace(/\bSept\b/, "Sep");

const sourceEntries = posts
  .map((p) => ({ title: publicationForPath(`/${p.id}`)?.title ?? p.data.title, href: `/${p.id}`, when: fmt(p.data.updated) }))
  .concat([{ title: "Finding a princess on a rectangle", href: "/princess/", when: "24 Oct 2026" }])
  .concat([{ title: "Guaranteed delivery despite a pursuer", href: "/cop-prisoner/", when: "18 Sep 2026" }])
  .concat([{ title: "Sleep performance", href: "/sleep-notebook/", when: "13 Oct 2026" }]);
const entries = sourceEntries.map(entry => ({...entry, title: publicationForPath(entry.href)?.title ?? entry.title}));

// Subject groups and reading order; article URLs and content stay unchanged.
const groups: { id: string; title: string; items: { href: string }[] }[] = [
  {
    id: "ai-and-machine-learning",
    title: "AI and machine learning",
    items: [
      { href: "/distributed-agent-training-and-evaluation" },
      { href: "/scaling-laws-for-generative-reward-models" },
      { href: "/model-specialization-and-training-agents" },
      { href: "/from-software-work-to-specialized-agents" },
      { href: "/explicit-versus-learned-search" },
      { href: "/scalable-meta-learning-from-hindsight" },
    ],
  },
  {
    id: "mathematics",
    title: "Mathematics",
    items: [
      { href: "/a-generalization-of-descent-polynomials" },
      { href: "/princess/" },
      { href: "/cop-prisoner/" },
      { href: "/four-arm-polyominoes" },
    ],
  },
  {
    id: "human-agency",
    title: "Human agency",
    items: [
      { href: "/the-optimization-nobody-is-running" },
      { href: "/four-levers-and-a-trap" },
    ],
  },
  {
    id: "running",
    title: "Running",
    items: [
      { href: "/running-notebook" },
      { href: "/what-should-a-running-workout-maximize" },
      { href: "/running-makes-the-city-smaller" },
    ],
  },
  {
    id: "food-and-nutrition",
    title: "Food and nutrition",
    items: [
      { href: "/nutrition-notebook" },
    ],
  },
  {
    id: "sleep",
    title: "Sleep",
    items: [
      { href: "/sleep-notebook/" },
    ],
  },
];

const entriesByHref = new Map(entries.map((entry) => [entry.href, entry]));
const assigned = new Set<string>();
const sections = groups.map((group) => ({
  ...group,
  entries: group.items.map(({ href }) => {
    const entry = entriesByHref.get(href);
    if (!entry) throw new Error(`Homepage group references an unpublished article: ${href}`);
    if (["ai-and-machine-learning", "mathematics"].includes(group.id) && !publicationForPath(href)) {
      throw new Error(`Register portfolio article resources before listing it: ${href}`);
    }
    if (assigned.has(href)) throw new Error(`Article appears in two homepage groups: ${href}`);
    assigned.add(href);
    return entry;
  }),
}));
const ungrouped = entries.filter((entry) => !assigned.has(entry.href));
if (ungrouped.length) {
  throw new Error(`Assign new articles to a homepage group: ${ungrouped.map((entry) => entry.href).join(", ")}`);
}
const mainSections = sections.filter(section => ["ai-and-machine-learning", "mathematics"].includes(section.id));
const writing = sections.find(section => section.id === "human-agency")!;
---
<Base home={true} description={introduction}>
  <p class="intro">{introduction}</p>
  {mainSections.map((section) => (
    <section aria-labelledby={section.id}>
      <h2 id={section.id}>{section.title}</h2>
      <ul class="idx">
        {section.entries.map((e) => (
          <li>
            <a href={publicationForPath(e.href)?.overview ?? e.href}>{publicationForPath(e.href)?.title ?? e.title}</a>
            <span class="when">{e.when}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <div class="secondary">
    <section aria-labelledby="writing">
      <span id="human-agency" class="anchor-alias" aria-hidden="true"></span>
      <h2 id="writing">Writing</h2>
      <ul class="writing-links">
        {writing.entries.map(entry => <li><a href={entry.href}>{entry.title}</a></li>)}
      </ul>
    </section>
    <section aria-labelledby="running">
      <h2 id="running"><a href="/running/record/">Running</a></h2>
      <p>An ongoing 800–5000 m project: training decisions, progress and the race record.</p>
    </section>
    <p class="personal-records" id="personal-records">
      <strong>Personal records</strong><span aria-hidden="true"> · </span>
      <a id="food-and-nutrition" href="/nutrition/record/">Food</a><span aria-hidden="true"> · </span><a id="sleep" href="/sleep/record/">Sleep</a>
    </p>
  </div>
</Base>

<style>
  .intro { margin-bottom: 48px; }
  section:first-of-type h2 { margin-top: 0; }
  .secondary { border-top: 1px solid var(--rule); margin-top: 56px; padding-top: 12px; font-size: 13px; }
  .secondary h2 { font-size: 13px; margin-top: 28px; margin-bottom: 10px; }
  .secondary p { margin-bottom: 0; }
  .writing-links { list-style: none; padding: 0; margin: 0; }
  .writing-links li { margin-bottom: 6px; }
  .personal-records { margin-top: 28px; }
  .anchor-alias { display: block; scroll-margin-top: 24px; }
</style>
