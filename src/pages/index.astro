---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

// Unwritten topics: keep this backlog in source, but do not render it on the site.
const ideas = [
  "AI",
  "Athleticism",
  "Brain optimization",
  "Ending war",
  "Getting bad stuff out of your system",
  "God project",
  "Healthy",
  "Internet and the digital nomad independence",
  "Mindset",
  "Recovery",
  "The deal with food",
  "The legal system, governments, institutions",
  "What is a business",
  "Who controls the world",
];

const posts = (await getCollection("posts")).filter((p) => !p.data.draft);

const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).replace(/\bSept\b/, "Sep");

const entries = posts
  .map((p) => ({ title: p.data.title, href: `/${p.id}`, when: fmt(p.data.updated) }))
  .concat([{ title: "Finding a princess on a rectangle", href: "/princess/", when: "13 Sep 2026" }])
  .concat([{ title: "Guaranteed delivery despite a pursuer", href: "/cop-prisoner/", when: "18 Sep 2026" }]);

// Subject groups and reading order; article URLs and content stay unchanged.
const groups: { id: string; title: string; items: { href: string }[] }[] = [
  {
    id: "ai-and-machine-learning",
    title: "AI and machine learning",
    items: [
      { href: "/training-a-code-reviewer-we-actually-use" },
      { href: "/scalable-meta-learning-from-hindsight" },
    ],
  },
  {
    id: "mathematics",
    title: "Mathematics",
    items: [
      { href: "/princess/" },
      { href: "/cop-prisoner/" },
      { href: "/four-arm-polyominoes" },
    ],
  },
  {
    id: "human-agency",
    title: "Human agency",
    items: [
      { href: "/the-optimization-nobody-is-running" },
      { href: "/four-levers-and-a-trap" },
    ],
  },
];

const entriesByHref = new Map(entries.map((entry) => [entry.href, entry]));
const assigned = new Set<string>();
const sections = groups.map((group) => ({
  ...group,
  entries: group.items.map(({ href }) => {
    const entry = entriesByHref.get(href);
    if (!entry) throw new Error(`Homepage group references an unpublished article: ${href}`);
    if (assigned.has(href)) throw new Error(`Article appears in two homepage groups: ${href}`);
    assigned.add(href);
    return entry;
  }),
}));
const ungrouped = entries.filter((entry) => !assigned.has(entry.href));
if (ungrouped.length) {
  throw new Error(`Assign new articles to a homepage group: ${ungrouped.map((entry) => entry.href).join(", ")}`);
}
---
<Base home={true}>
  {sections.map((section) => (
    <section aria-labelledby={section.id}>
      <h2 id={section.id}>{section.title}</h2>
      <ul class="idx">
        {section.entries.map((e) => (
          <li>
            <a href={e.href}>{e.title}</a>
            <span class="when">{e.when}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  section:first-child h2 { margin-top: 0; }
</style>
