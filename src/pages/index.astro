---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { reports } from "../data/reports";

const posts = (await getCollection("posts")).filter((p) => !p.data.draft);
const items = [
  ...reports.map((r) => ({ kind: "Report", href: `/reports/${r.slug}/`, title: r.title, description: r.description, date: new Date(r.date) })),
  ...posts.map((p) => ({ kind: "Note", href: `/writing/${p.id}`, title: p.data.title, description: p.data.description ?? "", date: p.data.date })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const fmt = (d: Date) => d.toLocaleDateString("en-GB", { month: "short", year: "numeric" });
---
<Base description="Angel Raychev - writing on physical capability, longevity, and how to tell which claims survive checking.">
  <h1 style="margin-top:52px">Angel Raychev</h1>
  <p class="lede">
    I work on physical capability and longevity &mdash; what can actually be measured,
    what the evidence supports once you check it, and what that implies for how to train
    across decades rather than seasons.
  </p>
  <p>
    Most of what I publish here is long. The reports below are research documents:
    each claim is labelled by where it comes from, and the headline numbers have been
    checked against their primary sources. Where something did not survive that check,
    it says so.
  </p>

  <h2>Writing</h2>
  <ul class="index">
    {items.map((it) => (
      <li>
        <a class="row" href={it.href}>
          <span class="t">{it.title}</span>
          <p class="d">{it.description}</p>
          <span class="r sans">
            <span class={`kind ${it.kind === "Report" ? "report" : ""}`}>{it.kind}</span>
            <span>{fmt(it.date)}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Base>
