---
import Base from "./Base.astro";
import PublicationHeader from "../components/PublicationHeader.astro";
import PublicationResources from "../components/PublicationResources.astro";
import { publicationForPath, absoluteResourceUrl } from "../lib/publications.mjs";
const { frontmatter } = Astro.props;
const fm = frontmatter ?? Astro.props;
const work = publicationForPath(Astro.url.pathname);
const title = work?.title ?? fm.title;
const fmt = (d) => new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).replace(/\bSept\b/, "Sep");
---
<Base title={title} description={fm.description} image={fm.image} imageAlt={fm.imageAlt} ogType="article">
  {work?.primary.pdf && <Fragment slot="head">
    <meta name="citation_title" content={work.manuscriptTitle} />
    {work.authors.map(author => <meta name="citation_author" content={author} />)}
    <meta name="citation_pdf_url" content={absoluteResourceUrl(work.primary.pdf.url)} />
    {work.manuscriptDate && <meta name="citation_publication_date" content={work.manuscriptDate.replaceAll('-', '/')} />}
    {work.records.filter(record => record.kind === 'arxiv').map(record => <meta name="citation_arxiv_id" content={record.url.split('/abs/')[1]} />)}
    {work.records.filter(record => record.kind === 'journal').map(record => <meta name="citation_doi" content={record.url.split('doi.org/')[1]} />)}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'ScholarlyArticle',
      name: work.manuscriptTitle, author: work.authors.map(name => ({'@type': 'Person', name})),
      url: absoluteResourceUrl(work.overview), description: fm.description,
      datePublished: work.manuscriptDate, dateModified: work.manuscriptModified,
      sameAs: work.records.map(record => record.url),
      encoding: {'@type': 'MediaObject', encodingFormat: 'application/pdf', contentUrl: absoluteResourceUrl(work.primary.pdf.url)},
    })} />
  </Fragment>}
  <article>
    <h1>{title}</h1>
    {work && <PublicationHeader work={work} />}
    {fm.updated && <p class="postmeta">Updated {fmt(fm.updated)}</p>}
    <slot />
    {work && <PublicationResources work={work} />}
  </article>
</Base>
