---
const { title, description, home = false } = Astro.props;
const NAME = "Angel Ivanov Raychev";
const full = title ? `${title} — ${NAME}` : NAME;
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={full} />
    {description && <meta property="og:description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, "https://angelraychev.com")} />
    <link rel="alternate" type="application/rss+xml" title={NAME} href="/rss.xml" />
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        {home ? <h1 class="sitename">{NAME}</h1> : <a href="/">{NAME}</a>}
      </header>
      <main><slot /></main>
      <footer class="site">angel.ivanov.raychev@gmail.com</footer>
    </div>
  </body>
</html>
