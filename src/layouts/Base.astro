---
const { title, description, image, imageAlt, home = false } = Astro.props;
const NAME = "Angel Ivanov Raychev";
const full = title ? `${title} — ${NAME}` : NAME;
const previewImage = image ? new URL(image, "https://angelraychev.com").href : undefined;
import "../styles/global.css";
import "katex/dist/katex.min.css";
import ThemeToggle from "../components/ThemeToggle.astro";
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        if (localStorage.getItem('angelraychev-theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch { /* Default to light when storage is unavailable. */ }
    </script>
    <title>{full}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={full} />
    {description && <meta property="og:description" content={description} />}
    {previewImage && <>
      <meta property="og:image" content={previewImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={imageAlt ?? full} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:image" content={previewImage} />
      <meta name="twitter:image:alt" content={imageAlt ?? full} />
    </>}
    <link rel="canonical" href={new URL(Astro.url.pathname, "https://angelraychev.com")} />
    <link rel="alternate" type="application/rss+xml" title={NAME} href="/rss.xml" />
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        {home ? <h1 class="sitename">{NAME}</h1> : <a href="/">{NAME}</a>}
        <ThemeToggle />
      </header>
      <main><slot /></main>
      <footer class="site">angel.ivanov.raychev@gmail.com</footer>
    </div>
  </body>
</html>
